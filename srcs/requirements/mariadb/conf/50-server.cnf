# MariaDB server configuration for the Inception project.
# Overrides Debian's default file of the same name.

[mysqld]
user                    = mysql
pid-file                = /run/mysqld/mysqld.pid
socket                  = /run/mysqld/mysqld.sock
basedir                 = /usr
datadir                 = /var/lib/mysql
tmpdir                  = /tmp
lc-messages-dir         = /usr/share/mysql

# Accept TCP connections from other containers on the docker network.
port                    = 3306
bind-address            = 0.0.0.0
skip-networking         = 0

# Small optimisation: don't do reverse-DNS on every client connection.
skip-name-resolve

character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci

[client]
socket                  = /run/mysqld/mysqld.sock

[mysql]
default-character-set   = utf8mb4
